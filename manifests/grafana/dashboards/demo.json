          "instant": true,
          "legendFormat": "Desired",
          "range": false,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "sum by (namespace, name, kind) (label_replace(label_replace(kube_deployment_status_replicas{namespace=~\"ui|catalog|carts|orders|checkout\"}, \"name\", \"$1\", \"deployment\", \"(.*)\"), \"kind\", \"deployment\", \"deployment\", \".*\")) or sum by (namespace, name, kind) (label_replace(label_replace(kube_statefulset_status_replicas{namespace=~\"ui|catalog|carts|orders|checkout\"}, \"name\", \"$1\", \"statefulset\", \"(.*)\"), \"kind\", \"statefulset\", \"statefulset\", \".*\"))",
          "format": "table",
          "instant": true,
          "legendFormat": "Current",
          "range": false,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "sum by (namespace, name, kind) (label_replace(label_replace(kube_deployment_status_replicas_ready{namespace=~\"ui|catalog|carts|orders|checkout\"}, \"name\", \"$1\", \"deployment\", \"(.*)\"), \"kind\", \"deployment\", \"deployment\", \".*\")) or sum by (namespace, name, kind) (label_replace(label_replace(kube_statefulset_status_replicas_ready{namespace=~\"ui|catalog|carts|orders|checkout\"}, \"name\", \"$1\", \"statefulset\", \"(.*)\"), \"kind\", \"statefulset\", \"statefulset\", \".*\"))",
          "format": "table",
          "instant": true,
          "legendFormat": "Ready",
          "range": false,
          "refId": "C"
        },
        {
          "editorMode": "code",
          "expr": "sum by (namespace, name, kind) (label_replace(label_replace(time() - kube_deployment_created{namespace=~\"ui|catalog|carts|orders|checkout\"}, \"name\", \"$1\", \"deployment\", \"(.*)\"), \"kind\", \"deployment\", \"deployment\", \".*\")) or sum by (namespace, name, kind) (label_replace(label_replace(time() - kube_statefulset_created{namespace=~\"ui|catalog|carts|orders|checkout\"}, \"name\", \"$1\", \"statefulset\", \"(.*)\"), \"kind\", \"statefulset\", \"statefulset\", \".*\"))",
          "format": "table",
          "instant": true,
          "legendFormat": "Age",
          "range": false,
          "refId": "D"
        }
      ],
      "title": "Workloads (Desired / Current / Ready / Age)",
