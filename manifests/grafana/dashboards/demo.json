      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (namespace, name, kind) (label_replace(label_replace(kube_deployment_spec_replicas{namespace=~\"ui|catalog|carts|orders|checkout\"}, \"name\", \"$1\", \"deployment\", \"(.*)\"), \"kind\", \"deployment\", \"deployment\", \".*\")) or sum by (namespace, name, kind) (label_replace(label_replace(kube_statefulset_replicas{namespace=~\"ui|catalog|carts|orders|checkout\"}, \"name\", \"$1\", \"statefulset\", \"(.*)\"), \"kind\", \"statefulset\", \"statefulset\", \".*\"))",
