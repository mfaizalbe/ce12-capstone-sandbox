# Pinned EBS volume IDs for the "retained" observability storage (see README "Create the retained EBS
# volumes" and helm/retained-storage.yaml). Source this file instead of copy-pasting exports so there is
# one place to update after recreating volumes (e.g. after they were deleted by the shared account's
# cleanup/"nuke" process):
#
#   source helm/ebs-volumes.env
#
# Before trusting these, verify they still exist — see README "Troubleshooting" section:
#   aws ec2 describe-volumes --volume-ids $PROMETHEUS_EBS_VOLUME_ID $LOKI_EBS_VOLUME_ID $GRAFANA_EBS_VOLUME_ID $ALERTMANAGER_EBS_VOLUME_ID $KUBECOST_EBS_VOLUME_ID --region ap-southeast-1

export PROMETHEUS_EBS_VOLUME_ID=vol-0d66de9f44d1fc29b
export PROMETHEUS_EBS_AZ=ap-southeast-1c

export LOKI_EBS_VOLUME_ID=vol-00521de6b4c731784
export LOKI_EBS_AZ=ap-southeast-1c

export GRAFANA_EBS_VOLUME_ID=vol-0808ed7e90e47a4dc
export GRAFANA_EBS_AZ=ap-southeast-1c

export ALERTMANAGER_EBS_VOLUME_ID=vol-07d3600229e61989b
export ALERTMANAGER_EBS_AZ=ap-southeast-1c

export KUBECOST_EBS_VOLUME_ID=vol-0fe06426ffb54ff65
export KUBECOST_EBS_AZ=ap-southeast-1c
