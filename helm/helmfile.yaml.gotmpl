repositories:
  - name: eks
    url: https://aws.github.io/eks-charts
  - name: external-dns
    url: https://kubernetes-sigs.github.io/external-dns/
  - name: open-telemetry
    url: https://open-telemetry.github.io/opentelemetry-helm-charts
  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts
  - name: grafana
    url: https://grafana.github.io/helm-charts

helmDefaults:
  wait: true
  timeout: 900
  atomic: false
  syncArgs:
    - --skip-crds

releases:
  - name: aws-load-balancer-controller
    namespace: kube-system
    createNamespace: false
    chart: eks/aws-load-balancer-controller
    version: 1.13.4
    hooks:
      - events: ["presync"]
        command: kubectl
        args: ["apply", "-k", "crds"]
    values:
      - values/aws-load-balancer-controller.yaml.gotmpl

  - name: external-dns
    namespace: external-dns
    createNamespace: true
    chart: external-dns/external-dns
    version: 1.21.1
    wait: false
    atomic: false
    needs:
      - kube-system/aws-load-balancer-controller
    values:
      - values/external-dns.yaml.gotmpl

  - name: prometheus
    namespace: monitoring
    createNamespace: true
    chart: prometheus-community/kube-prometheus-stack
    version: 69.0.0
    wait: false
    atomic: false
    hooks:
      - events: ["presync"]
        command: sh
        args:
          - -c
          - |
            set -eu
            : "${GRAFANA_EBS_VOLUME_ID:?Set GRAFANA_EBS_VOLUME_ID}"
            : "${GRAFANA_EBS_AZ:?Set GRAFANA_EBS_AZ}"
            : "${PROMETHEUS_EBS_VOLUME_ID:?Set PROMETHEUS_EBS_VOLUME_ID}"
            : "${PROMETHEUS_EBS_AZ:?Set PROMETHEUS_EBS_AZ}"
            : "${LOKI_EBS_VOLUME_ID:?Set LOKI_EBS_VOLUME_ID}"
            : "${LOKI_EBS_AZ:?Set LOKI_EBS_AZ}"
            kubectl create namespace monitoring --dry-run=client -o yaml | kubectl apply -f -
            envsubst '${GRAFANA_EBS_VOLUME_ID} ${GRAFANA_EBS_AZ} ${PROMETHEUS_EBS_VOLUME_ID} ${PROMETHEUS_EBS_AZ} ${LOKI_EBS_VOLUME_ID} ${LOKI_EBS_AZ}' < ./retained-storage.yaml | kubectl apply -f -
      - events: ["presync"]
        command: sh
        args:
          - -c
          - helm show crds prometheus-community/kube-prometheus-stack --version 69.0.0 | kubectl apply --server-side -f -
    needs:
      - kube-system/aws-load-balancer-controller
    values:
      - values/prometheus-stack.yaml

  - name: loki
    namespace: monitoring
    createNamespace: true
    chart: grafana/loki
    version: 6.29.0
    wait: false
    atomic: false
    values:
      - values/loki.yaml

  - name: opentelemetry-operator
    namespace: monitoring
    createNamespace: true
    chart: open-telemetry/opentelemetry-operator
    version: 0.115.0
    wait: false
    atomic: false
    values:
      - values/opentelemetry-operator.yaml

